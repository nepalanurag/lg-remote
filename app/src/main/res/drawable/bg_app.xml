<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.0"
                android:gradientRadius="420dp"
                android:startColor="#246EE7B7"
                android:endColor="#000B0F0E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="1.0"
                android:gradientRadius="380dp"
                android:startColor="#12181C1B"
                android:endColor="#000B0F0E" />
        </shape>
    </item>
</layer-list>
