<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- LG TVs serve their own self-signed certificate on wss://:3001; the app
         trusts it only on the local network. Cleartext is needed for older TVs. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
